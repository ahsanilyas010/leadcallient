# LeadCallient — environment variables.
#
# Supabase is REQUIRED: all data (accounts, campaigns, leads, calls, QA, ...)
# lives in Postgres. Stripe and Resend are optional per feature. Set them in
# Vercel under Project → Settings → Environment Variables. See README.md for
# Supabase project setup and the exact steps.

# --- Supabase (real customer accounts, workspaces, onboarding) --------------
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → service_role key. Server-side only, never
# exposed to the browser — bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Seeding (npm run seed) --------------------------------------------------
# Comma-separated emails of Assorted's own staff. Each must already have a
# Supabase Auth user (invite them first — Dashboard → Authentication, or
# auth.admin.inviteUserByEmail) before running the seed script.
PLATFORM_ADMIN_EMAILS=
# The vendor's own live workspace (slug "assorted"), seeded once from these.
ASSORTED_ADMIN_EMAIL=
ASSORTED_ADMIN_PASSWORD=
# Comma-separated E.164 numbers the seeded demo workspace can actually dial
# (e.g. +15550100000,+15550100001). With this empty the demo's dial queue is
# empty by design. After changing it run `npm run seed -- --reset`.
DEMO_ALLOWED_NUMBERS=
# Shared password for the 500-lead demo workspace's 6 seeded role accounts.
# Deliberately public/weak — documented, not secret.
DEMO_SEED_PASSWORD=LeadCallient@123

# --- Demo mode (Phase 9) -----------------------------------------------------
# Set to "true" to show a role switcher on /login for the seeded demo
# workspace (real database, real sign-in) and a "Reset data" button once
# signed in as one of those roles. Needs `npm run seed` to have run first.
NEXT_PUBLIC_DEMO_MODE=

# --- Zoom (calling + meetings) ------------------------------------------------
# NO Zoom keys go in this file. Meetings credentials (Account ID, Client ID,
# Client Secret of a Server-to-Server OAuth app) are entered per workspace at
# /admin/settings/zoom and stored encrypted in the database. Calling uses
# Zoom Phone Smart Embed: users sign in inside the phone panel, and a Zoom
# admin installs the Smart Embed app and approves this site's address.
#
# The address Zoom must approve. Set this when testing through a tunnel
# (ngrok / cloudflared) or any URL other than the deployed production domain;
# it is what the Zoom setup checklist displays. Leave empty on Vercel.
NEXT_PUBLIC_SITE_URL=

# --- RLS proof script (npm run test:rls) -------------------------------------
# Run this only against a disposable/staging Supabase project, never
# production — see scripts/rls-proof.ts. Optional: a test account for the
# platform_admin assertions (the script resets this account's password).
PLATFORM_ADMIN_TEST_EMAIL=
PLATFORM_ADMIN_TEST_PASSWORD=

# --- Resend (approved-template email to leads) ------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Signs unsubscribe links so they verify without a database lookup.
# Optional — falls back to SUPABASE_SERVICE_ROLE_KEY if unset.
EMAIL_UNSUBSCRIBE_SECRET=

# --- Stripe (upgrades, card payments) ----------------------------------------
STRIPE_SECRET_KEY=
# A recurring per-seat monthly price, graduated, with seats 1–3 at $0 (the free agents).
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Company contact details (shown on /contact, the footer, Agents & billing
# and the Contact buttons). Phone and WhatsApp default to Assorted Business's
# sales number (+92 321 8526405) in src/lib/brand.ts; set these only to
# override, or to "" to hide one.
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_WHATSAPP_URL=

# --- Bank transfer (Plan & billing). Shown only when the account name and at
# least one of IBAN / account number is set. Server-side only.
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_IBAN=
BANK_ACCOUNT_NUMBER=
BANK_SORT_CODE=
BANK_ROUTING_NUMBER=
BANK_SWIFT_BIC=
BANK_TRANSFER_NOTE=
